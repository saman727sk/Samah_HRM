          "enabled": true,
          "calculation": "structure",
          "formula": null,
          "proRate": true,
          "taxable": false,
          "showIfZero": false
        }
      },
      {
        "code": "OVERTIME",
        "name": "Overtime",
        "kind": "earning",
        "rules": {
          "enabled": true,
          "calculation": "formula",
          "formula": "round(OT_HOURS * HOURLY_RATE * 1.5 + OT_OFFDAY_HOURS * HOURLY_RATE * 2)",
          "proRate": false,
          "taxable": true,
          "showIfZero": false
        }
      },
      {
        "code": "ABSENT",
        "name": "Absence deduction",
        "kind": "deduction",
        "rules": {
          "enabled": true,
          "calculation": "formula",
          "formula": "round((ABSENT_DAYS + HALF_DAYS * 0.5) * DAILY_RATE)",
          "proRate": false,
          "taxable": true,
          "showIfZero": false
        }
      },
      {
        "code": "LATE",
        "name": "Late arrival deduction",
        "kind": "deduction",
        "rules": {
          "enabled": true,
          "calculation": "formula",
          "formula": "round(floor(LATE_COUNT / 3) * DAILY_RATE)",
          "proRate": false,
          "taxable": true,
          "showIfZero": false
        }
      },
      {
        "code": "UNPAID_LEAVE",
        "name": "Unpaid leave deduction",
        "kind": "deduction",
        "rules": {
          "enabled": true,
          "calculation": "formula",
          "formula": "round(UNPAID_LEAVE_DAYS * DAILY_RATE)",
          "proRate": false,
          "taxable": true,
          "showIfZero": false
        }
      },
      {
        "code": "TAX",
        "name": "Income tax",
        "kind": "deduction",
        "rules": {
          "enabled": true,
          "calculation": "formula",
          "formula": "round(tax(max(TAXABLE_EARNINGS - ABSENT - LATE - UNPAID_LEAVE, 0) * 12) / 12)",
          "proRate": false,
          "taxable": true,
          "showIfZero": false
        }
      },
      {
        "code": "EOBI",
        "name": "EOBI (employee share)",
        "kind": "deduction",
        "rules": {
          "enabled": true,
          "calculation": "formula",
          "formula": "round(MIN_WAGE * 0.01)",
          "proRate": false,
          "taxable": true,
          "showIfZero": false
        }
      },
